# Flutter App Environment Variables
# Copy to .env and fill in real values. NEVER commit .env files.

# Backend URL (use localhost for local testing)
BACKEND_URL=http://localhost:8000
LLM_API_ENDPOINT=http://localhost:8000

# App mode
IS_PRODUCTION_MODE=false
USE_VOICE_FEATURES=true
ENABLE_ANALYTICS=false

# Firebase (get from Firebase Console)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
