# Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env files.

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ai_therapist
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ai_therapist

# Security (REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# App Environment: local | development | staging | production
APP_ENV=local

# LLM Providers (at least one required for voice pipeline)
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# LLM Model Configuration
GROQ_LLM_MODEL_ID=llama-3.3-70b-versatile
GOOGLE_LLM_MODEL_ID=gemini-2.5-flash
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=sage
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Firebase
FIREBASE_PROJECT_ID=

# Stripe (optional — not needed for testing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
